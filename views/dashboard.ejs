<%- include('partials/head') %>
<%- include('partials/navbar') %>
<div class="container">
  <h3 class="mb-4">Panel Operativo del Aeropuerto</h3>
  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>
 <% if (typeof counts !== 'undefined' && counts) { %>
    <div class="row g-3">
      <% const tarjetas = [
        { key: 'aerolineas', label: 'Aerolíneas', color: 'primary' },
        { key: 'pistas', label: 'Pistas', color: 'success' },
        { key: 'torres_control', label: 'Torres de Control', color: 'info' },
        { key: 'aviones', label: 'Aviones', color: 'secondary' },
        { key: 'tripulaciones', label: 'Tripulación', color: 'dark' },
        { key: 'vuelos', label: 'Vuelos', color: 'warning' },
        { key: 'asignaciones_vuelo', label: 'Asignaciones Vuelo', color: 'danger' }
      ]; %>
      <% tarjetas.forEach(t => { %>
        <div class="col-md-4">
          <div class="card border-<%= t.color %> shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
              <div>
                <h6 class="text-muted mb-1"><%= t.label %></h6>
                <h2 class="mb-0"><%= counts[t.key] %></h2>
              </div>
              <a href="/gestion/<%= t.key %>" class="btn btn-outline-<%= t.color %> btn-sm">Gestionar</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>