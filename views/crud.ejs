<%- include('partials/head') %>
<%- include('partials/navbar') %>
<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3><%= entidad.titulo %></h3>
    <a href="/dashboard" class="btn btn-secondary btn-sm">Volver al Panel</a>
  </div>

  <% if (mensaje) { %>
    <div class="alert alert-success alert-dismissible fade show"><%= mensaje %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show"><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  <% } %>

  <% if (puedeEscribir) { %>
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-white fw-bold">Nuevo Registro</div>
      <div class="card-body">
        <form action="/gestion/<%= entidad.slug %>/crear" method="POST" class="row g-3">
          <% entidad.campos.forEach(campo => { %>
            <div class="col-md-4">
              <label class="form-label"><%= campo.label %></label>
              <% if (campo.type === 'select') { %>
                <select name="<%= campo.name %>" class="form-select" required>
                  <% campo.options.forEach(op => { %>
                    <option value="<%= op %>"><%= op %></option>
                  <% }) %>
                </select>
              <% } else if (campo.type === 'fk') { %>
                <select name="<%= campo.name %>" class="form-select" required>
                  <option value="">Seleccione...</option>
                  <% (opcionesFK[campo.name] || []).forEach(r => { %>
                    <option value="<%= r.id %>"><%= r.label %></option>
                  <% }) %>
                </select>
              <% } else { %>
                <input
                  type="<%= campo.type %>"
                  step="<%= campo.type === 'number' ? 'any' : '' %>"
                  name="<%= campo.name %>"
                  class="form-control"
                  placeholder="<%= campo.placeholder || '' %>"
                  required
                />
              <% } %>
            </div>
          <% }) %>
          <div class="col-12">
            <button type="submit" class="btn btn-primary">Guardar</button>
          </div>
        </form>
      </div>
    </div>
  <% } %>

  <div class="card shadow-sm">
    <div class="card-body table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <% Object.keys(registros[0] || {}).forEach(col => { %>
              <% if (col !== 'id') { %><th><%= col %></th><% } %>
            <% }) %>
            <% if (puedeEscribir || puedeEliminar) { %><th>Acciones</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% if (registros.length === 0) { %>
            <tr><td colspan="10" class="text-center text-muted py-4">Sin registros todavía</td></tr>
          <% } %>
          <% registros.forEach(reg => { %>
            <tr>
              <td><%= reg.id %></td>
              <% Object.entries(reg).forEach(([col, val]) => { %>
                <% if (col !== 'id') { %><td><%= val %></td><% } %>
              <% }) %>
              <% if (puedeEscribir || puedeEliminar) { %>
                <td class="text-nowrap">
                  <% if (puedeEliminar) { %>
                    <form action="/gestion/<%= entidad.slug %>/eliminar/<%= reg.id %>" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar registro?')">
                      <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                    </form>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>